# === Alpaca (US stocks) ===
# https://app.alpaca.markets → Paper account → Generate API key
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# 라이브 전환 시: https://api.alpaca.markets

# === Binance (Crypto) ===
# https://www.binance.com → API Management
# 권한: Read + Spot Trade. 출금 권한 OFF. IP whitelist 필수.
BINANCE_API_KEY=your_key_here
BINANCE_SECRET=your_secret_here
BINANCE_TESTNET=true
# 라이브 전환 시: BINANCE_TESTNET=false

# === Live trading hard gate ===
# paper 검증, IP whitelist, 출금 권한 OFF 확인 전에는 절대 true로 바꾸지 않는다.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK_RISK=false
LIVE_ORDER_SUBMISSION_ENABLED=false
LIVE_STRATEGY_ID=
LIVE_BROKER=alpaca-paper
LIVE_MAX_CAPITAL=0
LIVE_POLICY_VERSION=
LIVE_MIN_PAPER_DAYS=30
LIVE_MIN_SHADOW_DAYS=10
LIVE_MAX_LIMIT_DEVIATION=0.03
LIVE_MAX_MARK_DEVIATION=0.02
LIVE_ALLOW_MARKET_ORDERS=false
LIVE_CATALOG_DB=data/store/live-prices.duckdb

# === KIS API (한국, 라이브 거래용 — Stage 5에서 추가) ===
# https://apiportal.koreainvestment.com → 신청 → 승인까지 1~2일
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# === Polygon.io (인트라데이 미국 데이터 — Stage 4+ 선택) ===
POLYGON_API_KEY=

# ============================================================
# 미시경제 데이터 (Stage 1.5+)
# ============================================================

# === DART OpenAPI (한국 공시 + 임원·주요주주 보고) ===
# https://opendart.fss.or.kr → 인증키 신청 (즉시 발급, 무료)
DART_API_KEY=

# === FMP — Financial Modeling Prep (어닝/가이던스/컨센서스) ===
# https://site.financialmodelingprep.com → 무료 250 req/day
FMP_API_KEY=

# === Marketaux — 빠른 종목 뉴스 (trading-copilot news-fast 선택) ===
# https://www.marketaux.com → API token
MARKETAUX_API_KEY=

# === Alpha Vantage (펀더멘털 + 일부 거시) — 선택 ===
# https://www.alphavantage.co → 무료 25 req/day
ALPHAVANTAGE_API_KEY=

# === FRED (Federal Reserve Economic Data) — 미국 거시 ===
# https://fred.stlouisfed.org → API key 신청 (무료, 즉시)
# ALFRED vintage data 동일 키로 접근
FRED_API_KEY=

# === 한국은행 ECOS — 한국 거시 ===
# https://ecos.bok.or.kr/api/ → 인증키 신청 (무료, 즉시)
ECOS_API_KEY=

# === BEA (Bureau of Economic Analysis) — 미국 GDP 상세 (선택) ===
# https://apps.bea.gov/api/ → User ID 신청
BEA_API_KEY=

# === Trading Economics — 발표 캘린더 (선택, 일부 무료) ===
# https://tradingeconomics.com/api → 무료 키
TRADINGECONOMICS_API_KEY=

# ============================================================
# Sentiment & Flow (Stage 1.7+)
# ============================================================

# === Reddit (PRAW) — WSB/stocks 종목 mention ===
# https://www.reddit.com/prefs/apps → "create another app" → script
# 무료, 60 req/min
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trader-design/0.1 by lemon1825

# === GDELT — 키 불필요 (CSV / BigQuery) ===
# BigQuery 사용 시 GCP 프로젝트 필요 (1TB/월 무료)
GCP_PROJECT_ID=

# === CFTC COT — 키 불필요 (정부 공개 데이터) ===
# https://www.cftc.gov/MarketReports/CommitmentsofTraders/HistoricalCompressed/index.htm

# === SEC EDGAR — 키 불필요, User-Agent만 필수 ===
# 형식: "회사명 또는 이름 이메일주소"
SEC_USER_AGENT="lemon1825 lemon1825@naver.com"
TRADING_COPILOT_CONTACT="lemon1825 lemon1825@naver.com"

# === Etherscan — 크립토 온체인 (선택, Stage 5) ===
# https://etherscan.io/apis → 무료
ETHERSCAN_API_KEY=
