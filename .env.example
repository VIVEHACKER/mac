# === Alpaca (US stocks) ===
# https://app.alpaca.markets → Paper account → Generate API key
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# 라이브 전환 시: https://api.alpaca.markets

# === Binance (Crypto) ===
# https://www.binance.com → API Management
# 권한: Read + Spot Trade. 출금 권한 OFF. IP whitelist 필수.
BINANCE_API_KEY=your_key_here
BINANCE_SECRET=your_secret_here
BINANCE_TESTNET=true
# 라이브 전환 시: BINANCE_TESTNET=false

# === KIS API (한국, 라이브 거래용 — Stage 5에서 추가) ===
# https://apiportal.koreainvestment.com → 신청 → 승인까지 1~2일
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# === Polygon.io (인트라데이 미국 데이터 — Stage 4+ 선택) ===
POLYGON_API_KEY=
